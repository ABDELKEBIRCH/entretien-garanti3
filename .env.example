# Copier vers .env — ne jamais committer de vraies clés
APP_ENV=development
APP_SECRET=changez-moi-en-production-avec-une-cle-aleatoire-de-32-caracteres-minimum
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Base principale : laisser vide pour utiliser SQLite en local, ou fournir une URL PostgreSQL.
DATABASE_URL=
# SMTP facultatif : requis pour envoyer les confirmations d'entretien par e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Facultatif : si défini, les confirmations d'entretien sont envoyées à cette adresse.
INTERVIEW_NOTIFICATION_EMAIL=
