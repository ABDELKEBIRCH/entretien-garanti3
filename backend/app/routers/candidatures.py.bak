from __future__ import annotations

import json

from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel

from .. import db
from ..auth import current_user
from ..config import STATUTS
from ..services import journal, llm, matching, plans

router = APIRouter(prefix="/api/candidatures", tags=["candidatures"])


class CreateIn(BaseModel):
    offre_id: int


class PatchIn(BaseModel):
    statut: str | None = None
    lettre: str | None = None


def _profil(user: dict) -> dict:
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM profils WHERE user_id = ?", (user["id"],))
    if not row:
        raise HTTPException(status_code=400, detail="Profil incomplet.")
    out = dict(row)
    for key in ("competences", "experiences", "formation", "langues"):
        out[key] = db.parse_json(out.get(key), [])
    out["nom"] = user["nom"]
    return out


def _enrich(row: dict) -> dict:
    out = dict(row)
    out["explication"] = db.parse_json(out.get("explication"), {})
    return out


@router.get("")
def lister(user: dict = Depends(current_user)):
    with db.get_conn() as con:
        rows = db.fetchall(
            con,
            """
            SELECT c.*, o.titre, o.entreprise, o.ville, o.source, o.url
            FROM candidatures c JOIN offres o ON o.id = c.offre_id
            WHERE c.user_id = ? ORDER BY c.id DESC
            """,
            (user["id"],),
        )
    return {
        "agent_arrete": plans.agent_arrete(user["id"]),
        "compteurs": plans.compteur(user["id"]),
        "items": [_enrich(r) for r in rows],
    }


@router.post("")
def creer(body: CreateIn, user: dict = Depends(current_user)):
    if plans.agent_arrete(user["id"]):
        raise HTTPException(status_code=409, detail="Agent arrêté : entretien déjà obtenu.")
    with db.get_conn() as con:
        offre = db.fetchone(con, "SELECT * FROM offres WHERE id = ?", (body.offre_id,))
        if not offre:
            raise HTTPException(status_code=404, detail="Offre inconnue.")
        exist = db.fetchone(
            con,
            "SELECT * FROM candidatures WHERE user_id = ? AND offre_id = ?",
            (user["id"], body.offre_id),
        )
        if exist:
            return _enrich(exist)
    profil = _profil(user)
    expl = matching.scorer(profil, offre)
    now = db.now_iso()
    with db.get_conn() as con:
        cur = con.execute(
            """
            INSERT INTO candidatures (user_id, offre_id, score, explication, statut, date_creation, date_maj)
            VALUES (?, ?, ?, ?, 'a_envoyer', ?, ?)
            """,
            (user["id"], body.offre_id, expl["score"], json.dumps(expl, ensure_ascii=False), now, now),
        )
        cid = cur.lastrowid
        row = db.fetchone(
            con,
            """
            SELECT c.*, o.titre, o.entreprise, o.ville, o.source, o.url
            FROM candidatures c JOIN offres o ON o.id = c.offre_id WHERE c.id = ?
            """,
            (cid,),
        )
    journal.log(user["id"], "candidature_creee", {"id": cid, "offre_id": body.offre_id})
    return _enrich(row)


@router.patch("/{cid}")
def patch(cid: int, body: PatchIn, user: dict = Depends(current_user)):
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM candidatures WHERE id = ? AND user_id = ?", (cid, user["id"]))
        if not row:
            raise HTTPException(status_code=404, detail="Candidature introuvable.")
        statut = row["statut"]
        lettre = row["lettre"]
        if body.lettre is not None:
            lettre = body.lettre
        if body.statut is not None:
            if body.statut not in STATUTS:
                raise HTTPException(status_code=400, detail="Statut invalide.")
            statut = body.statut
        con.execute(
            "UPDATE candidatures SET statut=?, lettre=?, date_maj=? WHERE id=?",
            (statut, lettre, db.now_iso(), cid),
        )
        if statut == "entretien":
            journal.log(user["id"], "entretien_obtenu", {"id": cid})
            journal.log(user["id"], "agent_arrete", {"raison": "entretien obtenu"})
        row = db.fetchone(
            con,
            """
            SELECT c.*, o.titre, o.entreprise, o.ville, o.source, o.url
            FROM candidatures c JOIN offres o ON o.id = c.offre_id WHERE c.id = ?
            """,
            (cid,),
        )
    return _enrich(row)


@router.post("/{cid}/lettre")
def generer_lettre(cid: int, user: dict = Depends(current_user)):
    plans.assert_peut_generer_lettre(user)
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM candidatures WHERE id = ? AND user_id = ?", (cid, user["id"]))
        if not row:
            raise HTTPException(status_code=404, detail="Candidature introuvable.")
        offre = db.fetchone(con, "SELECT * FROM offres WHERE id = ?", (row["offre_id"],))
    profil = _profil(user)
    expl = db.parse_json(row.get("explication"), {})
    gen = llm.generer_lettre(profil, offre, expl)
    with db.get_conn() as con:
        con.execute(
            "UPDATE candidatures SET lettre=?, date_maj=? WHERE id=?",
            (gen["texte"], db.now_iso(), cid),
        )
    journal.log(user["id"], "lettre_generee", {"id": cid, "source": gen["source"]})
    return gen


@router.post("/{cid}/envoyer")
def envoyer(cid: int, user: dict = Depends(current_user)):
    plans.assert_peut_envoyer(user)
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM candidatures WHERE id = ? AND user_id = ?", (cid, user["id"]))
        if not row:
            raise HTTPException(status_code=404, detail="Candidature introuvable.")
        if not (row.get("lettre") or "").strip():
            raise HTTPException(status_code=400, detail="Validez ou générez une lettre avant l'envoi.")
        con.execute(
            "UPDATE candidatures SET statut='envoyee', date_maj=? WHERE id=?",
            (db.now_iso(), cid),
        )
        offre = db.fetchone(con, "SELECT titre, entreprise FROM offres WHERE id = ?", (row["offre_id"],))
    journal.log(user["id"], "candidature_envoyee", {"id": cid, "mode": "simule"})
    return {
        "ok": True,
        "message": (
            f"Candidature marquée comme envoyée (simulation pédagogique — aucun e-mail réel) "
            f"pour {offre['titre']} / {offre['entreprise']}."
        ),
    }


@router.post("/{cid}/cv-adapte")
def cv_adapte(cid: int, user: dict = Depends(current_user)):
    plans.assert_bonus(user, "cv_adapte")
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM candidatures WHERE id = ? AND user_id = ?", (cid, user["id"]))
        if not row:
            raise HTTPException(status_code=404, detail="Candidature introuvable.")
        offre = db.fetchone(con, "SELECT * FROM offres WHERE id = ?", (row["offre_id"],))
    texte = llm.adapter_cv(_profil(user), offre)
    with db.get_conn() as con:
        con.execute("UPDATE candidatures SET cv_adapte=?, date_maj=? WHERE id=?", (texte, db.now_iso(), cid))
    journal.log(user["id"], "cv_adapte", {"id": cid})
    return {"texte": texte}


@router.post("/{cid}/prep-entretien")
def prep(cid: int, user: dict = Depends(current_user)):
    plans.assert_bonus(user, "prep_entretien")
    with db.get_conn() as con:
        row = db.fetchone(con, "SELECT * FROM candidatures WHERE id = ? AND user_id = ?", (cid, user["id"]))
        if not row:
            raise HTTPException(status_code=404, detail="Candidature introuvable.")
        offre = db.fetchone(con, "SELECT * FROM offres WHERE id = ?", (row["offre_id"],))
    texte = llm.prep_entretien(_profil(user), offre)
    with db.get_conn() as con:
        con.execute(
            "UPDATE candidatures SET questions_entretien=?, date_maj=? WHERE id=?",
            (texte, db.now_iso(), cid),
        )
    journal.log(user["id"], "prep_entretien", {"id": cid})
    return {"texte": texte}
